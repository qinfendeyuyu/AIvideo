# This directory also contains private operations and large AI assets.
# Root allowlist: new top-level material stays private until reviewed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE
!/requirements.txt
!/app/
!/configs/
!/scripts/
!/integrations/
!/workflows/
!/tests/
!/docs/
!/assets/

/configs/*
!/configs/models.example.yaml
!/configs/episode.example.yaml
!/configs/episode.face-sample.yaml
!/configs/training/
/configs/training/*
!/configs/training/*.example.toml

/scripts/*
!/scripts/*.py
!/scripts/*.ps1
!/scripts/capture_project_screenshots.cjs
/scripts/_*
/scripts/run_wan_remote_desktop.py
/scripts/desktop_holiday/

/docs/*
!/docs/PUBLIC_DEPLOYMENT.md
!/docs/TOONFLOW_FREE_LOCAL.md
!/docs/COMMERCIAL_RIGHTS_LEDGER.md
!/docs/ALGORITHMS_AND_MODELS.md
!/docs/THIRD_PARTY_NOTICES.md
!/docs/SCREENSHOTS.md
!/docs/LEGACY_TOONFLOW.md
!/docs/licenses/
/docs/licenses/*
!/docs/licenses/Toonflow-72a895c2-MIT.txt
!/docs/licenses/Toonflow-legacy-e03cf590-LICENSE.txt
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/workbench-overview.png
!/docs/screenshots/generation-panels.png
!/docs/screenshots/service-status.png
!/docs/screenshots/capture-manifest.json

# Retired Toonflow 1.x provider: retained locally, not in current releases.
/integrations/toonflow/localWanComfy.ts

/assets/*
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/NotoSansSC/
/assets/fonts/NotoSansSC/*
!/assets/fonts/NotoSansSC/NotoSansSC-VF.ttf
!/assets/fonts/NotoSansSC/OFL.txt
!/assets/fonts/NotoSansSC/README.md

# Secrets, caches, models and generated media remain excluded everywhere.
.env
.env.*
*.private.*
*credentials*
*.pem
*.key
*.pfx
*.p12
*.ovpn
id_rsa*
id_ed25519*
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-temp*/
.venv*/
node_modules/
*.log
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
